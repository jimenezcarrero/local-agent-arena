#!/usr/bin/env bash
# llm — on-demand llama-server router control for the Jetson Orin Nano.
# Model recommendations come from the benchmark campaign:
#   github.com/jimenezcarrero/jetson-llm-benchmarks
set -euo pipefail

PORT=8080
API="http://localhost:$PORT"

bold=$(tput bold 2>/dev/null || true); dim=$(tput dim 2>/dev/null || true)
grn=$(tput setaf 2 2>/dev/null || true); ylw=$(tput setaf 3 2>/dev/null || true)
rst=$(tput sgr0 2>/dev/null || true)

running() { curl -sf -m 2 "$API/models" >/dev/null 2>&1; }

loaded_model() {
  curl -sf -m 2 "$API/models" 2>/dev/null \
    | python3 -c "import json,sys; print(next((m['id'] for m in json.load(sys.stdin)['data'] if m['status']['value']=='loaded'), 'none'))" 2>/dev/null \
    || echo "none"
}

status() {
  if running; then
    echo "${grn}● router running${rst} on :$PORT — loaded model: ${bold}$(loaded_model)${rst}"
    free -m | awk 'NR==2 {printf "  memory: %d MB used / %d MB total\n", $3, $2}'
  else
    echo "${dim}○ router stopped${rst} (start with: llm start)"
  fi
}

start() {
  if running; then echo "already running"; status; return; fi
  echo "starting llama-server router..."
  free_pagecache
  sudo systemctl start llama-server
  for _ in $(seq 1 20); do running && break; sleep 1; done
  running || { echo "failed to start — check: journalctl -u llama-server -n 30"; exit 1; }
  status
  echo "${dim}no model loaded yet — first request auto-loads, or pick one now:${rst}"
  menu
}

stop() { sudo systemctl stop llama-server; echo "router stopped (GPU memory freed)"; }

# Jetson: a big mmap'd model fills page cache and starves NvMap of the
# contiguous pages a large CUDA buffer needs. Reclaim before loading.
free_pagecache() { sync; sudo -n sh -c 'echo 3 > /proc/sys/vm/drop_caches' 2>/dev/null || true; sleep 1; }

load() {
  local m="$1"
  free_pagecache
  echo "loading ${bold}$m${rst} (previous model is unloaded first)..."
  curl -sf -m 300 "$API/v1/chat/completions" -H 'Content-Type: application/json' \
    -d "{\"model\":\"$m\",\"messages\":[{\"role\":\"user\",\"content\":\"ok\"}],\"max_tokens\":1}" >/dev/null \
    && echo "${grn}✓ $m loaded and warm${rst}" \
    || echo "load failed — check: journalctl -u llama-server -n 30"
}

menu() {
  cat <<EOF

${bold}Which model? (arena-validated recommendations)${rst}
  1) ornith       ${grn}★ CHAMPION${rst} — undefeated, best for sessions      (65K)
  2) ornith15     faster one-shot than champion, 10/11 marathon   (65K)
  3) ling         ${grn}fastest overall${rst} 34 t/s, best energy — needs big ctx (131K)
  4) a1-131k      fastest perfect marathon                        (131K)
  5) a1-262k      max context on this board                       (262K)
  6) e2b-32k      ~58 t/s chat +MTP, weak in long sessions          (32K)
  7) e4b-32k      quality gemma +MTP, keep at 32K                   (32K)
  8) nanbeige-32k cap at 32K (8x slower at 49K)                     (32K)
  9) lfm25        tool-use/RAG only, NOT for coding               (262K)
  0) qwen9b-base  control: no agentic tuning                        (32K)
  q) skip (auto-loads on first request)
EOF
  read -rp "> " ans || ans=q
  case "$ans" in
    1) load ornith ;;       2) load ornith15 ;;  3) load ling ;;
    4) load a1-131k ;;      5) load a1-262k ;;   6) load e2b-32k ;;
    7) load e4b-32k ;;      8) load nanbeige-32k ;; 9) load lfm25 ;;
    0) load qwen9b-base ;;
    *) echo "ok — the router will load whatever model pi requests." ;;
  esac
}

case "${1:-}" in
  start)  start ;;
  stop)   stop ;;
  status|"") status ;;
  load)   running || start; load "${2:?usage: llm load <model>}" ;;
  pick)   running || { sudo systemctl start llama-server; sleep 3; }; menu ;;
  models) running || { echo "${dim}router is not running — start it with: llm start${rst}"; exit 0; }
          curl -s "$API/models" | python3 -c "
import json,sys
try:
    d=json.load(sys.stdin)['data']
except Exception:
    print('could not read model list from the router'); sys.exit(1)
for m in sorted(d, key=lambda x: x['id']):
    print(f\"  {m['id']:<14} {m['status']['value']}\")" ;;
  logs)   exec journalctl -u llama-server -f -n "${2:-100}" ;;
  help)   cat <<EOF
${bold}llm — on-demand model serving on this Jetson${rst}
Full docs: ~/llm-server/README.md (same file: repo server/README.md)

${bold}Commands${rst}
  llm start        start the router via systemd (no model loaded, GPU stays
                   free) and show the model menu. Logs go to journald.
  llm stop         stop router + loaded model, free the GPU
  llm status       running? which model is loaded? memory use
  llm pick         show the recommendation menu again
  llm load NAME    preload a model (warm-up request; previous one unloads first)
  llm models       list every preset and its loaded/unloaded state
  llm logs [N]     follow the server log live (last N lines first, default 100)
  llm fg           run the router in THIS terminal with visible logs (Ctrl-C
                   stops; refuses if the systemd service is already running)

${bold}How it works${rst}
  llama-server runs in router mode (--models-preset ~/llm-server/jetson-models.ini
  --models-max 1). Any request naming a preset in its "model" field makes the
  router load that model with its tuned flags, unloading the previous one first
  — so switching models inside pi (/model) is all you ever need.

${bold}Add a new model (3 steps)${rst}
  1. put the GGUF in ~/Repositories/llama.cpp/models/  (weights+KV ≤ ~5GB)
  2. add a section to ~/llm-server/jetson-models.ini:
       [mymodel-64k]
       model = /full/path/to/model.gguf
       c = 65536
       ctk = q4_0
       ctv = q4_0
     then: sudo systemctl restart llama-server
  3. add a matching entry (id + contextWindow) in ~/.pi/agent/models.json
     so pi can select it and compaction triggers at the right size

${bold}Updating llama.cpp${rst}
  cd ~/Repositories/llama.cpp && git pull
  cmake --build build-novmm -j3 --target llama-server
  The router uses build-novmm (NOT the llama.app binary): it has bailingmoe3
  for Ling and disables CUDA VMM, which is broken on Tegra.

${bold}If a model "failed to load"${rst}
  It is almost always memory, not a bad preset. Free RAM decides which models
  fit: ~5 GB with a desktop session, ~6.9 GB headless.
    llm load NAME   reclaims page cache first (that alone fixes most failures)
    llm stop        then close browsers/Claude and retry
  Models near 4.9 GB (ornith15-fast) need a nearly idle board. Switching models
  from inside pi does NOT reclaim cache - use `llm load NAME` for the big ones.
EOF
  ;;
  fg)     # run in the foreground with logs in this terminal (Ctrl-C stops it)
          running && { echo "already running as a service — 'llm stop' first"; exit 1; }
          exec /home/JetsonOrin/Repositories/llama.cpp/build-novmm/bin/llama-server \
            --models-preset /home/JetsonOrin/llm-server/jetson-models.ini \
            --models-max 1 --host 0.0.0.0 --port 8080 ;;
  *) echo "usage: llm [help|status|start|stop|pick|load <model>|models|logs [N]|fg]"; exit 1 ;;
esac
